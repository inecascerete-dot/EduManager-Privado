# Copia este archivo como secrets.toml solamente en el entorno local o cloud.
# No coloques credenciales reales en Git.

DB_HOST = "tu-host-de-supabase"
DB_NAME = "postgres"
DB_USER = "tu-usuario-de-supabase"
DB_PASSWORD = "tu-contrasena-de-supabase"
DB_PORT = "5432"
DB_SSLMODE = "require"

# Opcionales; los valores predeterminados de la aplicación son 1 y 5.
DB_POOL_MINCONN = 1
DB_POOL_MAXCONN = 5
